# Local Postgres/container values only. Change these before any deployment.
POSTGRES_PASSWORD=change-this-local-password

# Optional Razorpay integration: use test keys for local validation.
# Never commit real provider credentials or place them in frontend variables.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
